<% layout("/layouts/boilerplate")%>

<body>
    <!--<h3> All listings</h3>-->
    <!--<form method="GET" action="/listings/new">
        <button>Create new listings</button>
    </form>-->
    <style>
       /* =========================
   CATEGORIES
========================= */

#filters {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 15px 5px;
    margin-bottom: 10px;
    overflow-x: auto;
    scrollbar-width: none;
}

#filters::-webkit-scrollbar {
    display: none;
}

.filter {
    min-width: 70px;
    text-align: center;
    margin: 0;
    opacity: 0.7;
    color: #222;
    transition: 0.2s ease;
    white-space: nowrap;
}

.filter:hover {
    opacity: 1;
    transform: translateY(-2px);
}

.filter i {
    font-size: 1.2rem;
    margin-bottom: 6px;
}

.filter p {
    font-size: 0.75rem;
    margin: 0;
}


/* Tax toggle */

.tax-toggle {
    margin-left: auto;
    flex-shrink: 0;
}


/* =========================
   MOBILE CATEGORIES
========================= */

@media (max-width: 767px) {

    #filters {
        gap: 22px;
        padding: 10px 5px;
        margin-bottom: 10px;
    }

    .filter {
        min-width: 65px;
    }

    .filter i {
        font-size: 1.15rem;
    }

    .filter p {
        font-size: 0.7rem;
        margin-top: 5px;
    }

    .tax-toggle {
        margin-left: 10px;
        flex-shrink: 0;
    }
}

    </style>
    <div id="filters">
        <button class="mobile-menu-btn" id="categoryToggle">
    ☰
</button>
       <a href="/listings/category/Trending" class="filter text-decoration-none text-dark">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>

    <a href="/listings/category/Rooms" class="filter text-decoration-none text-dark">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </a>

    <a href="/listings/category/Iconic cities" class="filter text-decoration-none text-dark">
        <div><i class="fa-solid fa-city"></i></div>
        <p>Iconic Cities</p>
    </a>

    <a href="/listings/category/Mountains" class="filter text-decoration-none text-dark">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </a>

    <a href="/listings/category/Castles" class="filter text-decoration-none text-dark">
        <div><i class="fa-solid fa-chess-rook"></i></div>
        <p>Castles</p>
    </a>

    <a href="/listings/category/Amazing pools" class="filter text-decoration-none text-dark">
        <div><i class="fa-solid fa-water-ladder"></i></div>
        <p>Amazing Pools</p>
    </a>

    <a href="/listings/category/Camping" class="filter text-decoration-none text-dark">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </a>

    <a href="/listings/category/Farms" class="filter text-decoration-none text-dark">
        <div><i class="fa-solid fa-tractor"></i></div>
        <p>Farms</p>
    </a>

    <a href="/listings/category/Arctic" class="filter text-decoration-none text-dark">
        <div><i class="fa-regular fa-snowflake"></i></div>
        <p>Arctic</p>
    </a>

    <a href="/listings/category/Domes" class="filter text-decoration-none text-dark">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
    </a>

    <a href="/listings/category/Houseboat" class="filter text-decoration-none text-dark">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Houseboats</p>
    </a>
        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display total after Taxes</label>
</div>
        </div>
    </div>
    
    
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 mt-3">
    <% for(let listing of allListings) { %>
        <div class="col">
            <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                
                <div class="card listing-card h-100">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem">
                    <div class="card-img-overlay"></div>

                    
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %></b><br>
                            &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
                            <i class="tax-info">&nbsp;&nbsp; +18% GST</i>
                        </p>
                    </div>
                </div>

            </a>
        </div>
    <% } %>
</div>
 <script>
    let taxSwitch=document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click",()=>{
    let taxInfo=document.getElementsByClassName("tax-info");
    for (info of taxInfo){
        if(info.style.display!="inline"){
         info.style.display = "inline";
        }else{
            info.style.display = "none";
        }
    
    }
    })
    const categoryToggle = document.getElementById("categoryToggle");

categoryToggle.addEventListener("click", () => {
    document.getElementById("filters").classList.toggle("categories-open");
});
 </script>



    


